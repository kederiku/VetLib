# ===== PostgreSQL =====
POSTGRES_USER=postgres            # superuser — réservé aux migrations Alembic
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vetolib
APP_DB_USER=vetolib_app           # rôle applicatif NON-superuser -> RLS effective
APP_DB_PASSWORD=vetolib_app_dev
# URLs vues depuis les conteneurs (hostnames Docker). Hors Docker : remplacer par localhost.
# Le pool applicatif se connecte en rôle PROPRIÉTAIRE (flux système : login, register).
# Les transactions tenant font SET LOCAL ROLE vetolib_app + SET LOCAL app.clinic_id -> RLS effective.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/vetolib
ALEMBIC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/vetolib
APP_DB_ROLE=vetolib_app

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== MinIO (S3) =====
MINIO_ROOT_USER=vetolib
MINIO_ROOT_PASSWORD=vetolib-dev-secret
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_DOCUMENTS=vetolib-documents

# ===== Auth =====
JWT_SECRET=dev-only-secret-change-me-0123456789
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
COOKIE_SECURE=false               # true en prod (HTTPS)

# ===== Divers =====
ENV=dev
LOG_JSON=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ===== Frontends =====
NEXT_PUBLIC_API_URL=http://localhost:8000
