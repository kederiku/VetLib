# Contexte de build = racine (docker/frontend/Dockerfile via ARG APP_DIR).
.git/
node_modules/
frontend-b2c/node_modules/
frontend-b2c/.next/
frontend-b2b/node_modules/
frontend-b2b/.next/
frontend-admin/node_modules/
frontend-admin/.next/
backend/.venv/
backend/.mypy_cache/
backend/.pytest_cache/
backend/.ruff_cache/
.env
.env.*
!.env.example
backend/.env

# Le site de documentation n'entre dans aucune image : il est publie sur GitHub
# Pages par la CI. L'exclure du contexte evite d'envoyer au demon Docker des
# milliers de fichiers a chaque build des images frontend, dont le contexte est
# la racine du depot.
documentation/
