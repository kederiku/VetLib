# Exécution du backend HORS Docker (make dev) — l'infra reste dans Docker.
ENV=dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vetolib
ALEMBIC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vetolib
APP_DB_ROLE=vetolib_app
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=dev-only-secret-change-me-0123456789
COOKIE_SECURE=false
LOG_JSON=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3003"]
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_DOCUMENTS=vetolib-documents
